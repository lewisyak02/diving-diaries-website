# Stripe secret key, from dashboard.stripe.com > Developers > API keys.
# Set this in Netlify as an environment variable too, never commit the real one.
# Use the sk_test_... key while testing, swap to sk_live_... when going live.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret, from dashboard.stripe.com > Developers >
# Webhooks > your endpoint. This is what lets the site trust that an order
# really was paid, so the stock counter can come down. Test and live modes have
# different secrets, same as the API key above.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Password for /stock, the stock counter. Make one up, put the same value in
# Netlify. Without it the counter page and its API are switched off entirely.
STOCK_TOKEN=make_one_up
