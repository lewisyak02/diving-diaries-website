---
// Slide over cart. Opened from the header, and by adding anything to it.
---

<button
  type="button"
  id="cart-open"
  class="relative flex items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wide text-white/85 transition-colors hover:bg-white/10 hover:text-white"
  aria-label="Open cart"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" />
    <path d="M2 3h3l2.4 12.1a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.2L21 7H6" />
  </svg>
  <span id="cart-count" class="cart-badge" hidden>0</span>
</button>

<div id="cart" class="cart" hidden>
  <div class="cart__scrim" data-cart-close></div>
  <aside class="cart__panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <header class="cart__head">
      <h2>Your cart</h2>
      <button type="button" data-cart-close aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <div id="cart-lines" class="cart__lines"></div>

    <footer class="cart__foot">
      <dl>
        <div><dt>Subtotal</dt><dd id="cart-subtotal">$0</dd></div>
        <div><dt>Shipping</dt><dd>$1.50</dd></div>
        <div class="cart__total"><dt>Total</dt><dd id="cart-total">$0</dd></div>
      </dl>
      <p id="cart-error" class="cart__error" hidden></p>
      <button type="button" id="cart-checkout" class="cart__checkout">Checkout</button>
      <p class="cart__note">Australia wide shipping. Secure payment by Stripe.</p>
    </footer>
  </aside>
</div>

<style>
  .cart-badge {
    position: absolute;
    top: -0.1rem;
    right: -0.1rem;
    min-width: 1.15rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--color-purple-500, #6e65dc);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.68rem;
    line-height: 1.15rem;
    text-align: center;
  }

  .cart { position: fixed; inset: 0; z-index: 60; }
  .cart__scrim { position: absolute; inset: 0; background: rgba(1, 18, 58, 0.55); backdrop-filter: blur(2px); }
  .cart__panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    width: min(26rem, 100%);
    flex-direction: column;
    background: #fff;
    box-shadow: -20px 0 60px rgba(1, 18, 58, 0.25);
  }
  .cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--color-ocean-100, #dce7fb);
  }
  .cart__head h2 { font-family: var(--font-display); font-size: 1.25rem; text-transform: uppercase; color: var(--color-ocean-800, #012364); }
  .cart__head button { color: var(--color-ocean-800, #012364); cursor: pointer; }

  .cart__lines { flex: 1; overflow-y: auto; padding: 0.5rem 1.25rem; }
  /* Everything below is injected by script, so it never carries Astro's scope
     attribute and has to be declared global to apply at all. */
  :global(.cart__empty) { padding: 2.5rem 0; text-align: center; color: #64748b; }

  :global(.cart-line) { display: flex; gap: 0.85rem; padding: 0.9rem 0; border-bottom: 1px solid #eef2f9; }
  :global(.cart-line) :global(img) { width: 3.5rem; height: 3.5rem; flex: none; object-fit: contain; border-radius: 0.6rem; background: #2d4870; }
  :global(.cart-line__body) { flex: 1; min-width: 0; }
  :global(.cart-line__name) { font-weight: 700; font-size: 0.9rem; color: var(--color-ocean-800, #012364); }
  :global(.cart-line__meta) { margin-top: 0.15rem; font-size: 0.72rem; line-height: 1.35; color: #64748b; }
  :global(.cart-line__row) { margin-top: 0.5rem; display: flex; align-items: center; gap: 0.75rem; }
  :global(.cart-line__qty) { display: inline-flex; align-items: center; gap: 0.35rem; border: 1px solid var(--color-ocean-100, #dce7fb); border-radius: 999px; padding: 0.1rem; }
  :global(.cart-line__qty) :global(button) { width: 1.5rem; height: 1.5rem; border-radius: 999px; color: var(--color-ocean-700, #013ec4); font-weight: 700; cursor: pointer; }
  :global(.cart-line__qty) :global(button:disabled) { opacity: 0.35; cursor: not-allowed; }
  :global(.cart-line__qty) :global(span) { min-width: 1.1rem; text-align: center; font-size: 0.85rem; font-weight: 700; }
  :global(.cart-line__price) { margin-left: auto; font-family: var(--font-display); font-weight: 700; color: var(--color-purple-600, #5a51c8); }
  :global(.cart-line__remove) { font-size: 0.72rem; color: #94a3b8; text-decoration: underline; cursor: pointer; }
  :global(.cart-line__remove:hover) { color: #475569; }

  .cart__foot { border-top: 1px solid var(--color-ocean-100, #dce7fb); padding: 1.1rem 1.25rem 1.35rem; }
  .cart__foot dl div { display: flex; justify-content: space-between; font-size: 0.85rem; color: #475569; padding: 0.12rem 0; }
  .cart__total { margin-top: 0.4rem; padding-top: 0.5rem !important; border-top: 1px solid #eef2f9; font-size: 1rem !important; font-weight: 700; color: var(--color-ocean-800, #012364) !important; }
  .cart__checkout {
    margin-top: 0.9rem;
    width: 100%;
    border-radius: 999px;
    background: var(--color-purple-500, #6e65dc);
    padding: 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .cart__checkout:hover { background: var(--color-purple-600, #5a51c8); }
  .cart__checkout:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; }
  .cart__error { margin-top: 0.7rem; font-size: 0.8rem; font-weight: 600; color: #b91c1c; }
  .cart__note { margin-top: 0.6rem; text-align: center; font-size: 0.7rem; color: #94a3b8; }
</style>

<script>
  import { readCart, cartCount, cartTotal, setQty, removeLine, onCartChange, money } from '../lib/cart';

  const root = document.getElementById('cart')!;
  // The header uses backdrop-filter, which makes it the containing block for
  // any position:fixed descendant. The drawer has to live on the body or it
  // gets trapped inside a 60px tall nav bar.
  if (root.parentElement !== document.body) document.body.appendChild(root);
  const openBtn = document.getElementById('cart-open')!;
  const badge = document.getElementById('cart-count')!;
  const linesEl = document.getElementById('cart-lines')!;
  const subtotalEl = document.getElementById('cart-subtotal')!;
  const totalEl = document.getElementById('cart-total')!;
  const errorEl = document.getElementById('cart-error') as HTMLElement;
  const checkoutBtn = document.getElementById('cart-checkout') as HTMLButtonElement;
  const SHIPPING = 1.5;

  const open = () => {
    root.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    root.hidden = true;
    document.body.style.overflow = '';
  };

  openBtn.addEventListener('click', open);
  root.querySelectorAll('[data-cart-close]').forEach((b) => b.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !root.hidden) close();
  });
  // Adding something should show what just happened.
  window.addEventListener('dd-cart-open', open);

  function render() {
    const lines = readCart();
    const n = cartCount(lines);
    badge.textContent = String(n);
    badge.hidden = n === 0;

    if (!lines.length) {
      linesEl.innerHTML = '<p class="cart__empty">Nothing in here yet.</p>';
      checkoutBtn.disabled = true;
    } else {
      checkoutBtn.disabled = false;
      linesEl.innerHTML = lines
        .map((l, i) => {
          const meta = l.packLabels?.length
            ? `<p class="cart-line__meta">${l.packLabels.join(', ')}</p>`
            : '';
          return `<div class="cart-line">
            ${l.thumb ? `<img src="${l.thumb}" alt="" loading="lazy">` : ''}
            <div class="cart-line__body">
              <p class="cart-line__name">${l.name}</p>
              ${meta}
              <div class="cart-line__row">
                <span class="cart-line__qty">
                  <button type="button" data-less="${i}" aria-label="One fewer">-</button>
                  <span>${l.qty}</span>
                  <button type="button" data-more="${i}" aria-label="One more">+</button>
                </span>
                <button type="button" class="cart-line__remove" data-remove="${i}">Remove</button>
                <span class="cart-line__price">${money(l.qty * l.price)}</span>
              </div>
            </div>
          </div>`;
        })
        .join('');
    }

    const sub = cartTotal(lines);
    subtotalEl.textContent = money(sub);
    totalEl.textContent = money(lines.length ? sub + SHIPPING : 0);
  }

  linesEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const lines = readCart();
    if (t.dataset.more !== undefined) {
      const i = Number(t.dataset.more);
      setQty(i, lines[i].qty + 1);
    } else if (t.dataset.less !== undefined) {
      const i = Number(t.dataset.less);
      // A pack is all or nothing, and a minimum order cannot be undercut.
      if (lines[i].qty <= 1) removeLine(i);
      else setQty(i, lines[i].qty - 1);
    } else if (t.dataset.remove !== undefined) {
      removeLine(Number(t.dataset.remove));
    }
  });

  checkoutBtn.addEventListener('click', async () => {
    errorEl.hidden = true;
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Taking you to Stripe...';
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          lines: readCart().map((l) => ({ id: l.id, qty: l.qty, pack: l.pack })),
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.url) throw new Error(data.error || 'Checkout is not available.');
      window.location.href = data.url;
      return;
    } catch (err) {
      errorEl.textContent = (err as Error).message;
      errorEl.hidden = false;
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = 'Checkout';
    }
  });

  onCartChange(render);
  render();
</script>
