---
// Mix and match pack. Pick a fixed number of stickers from the range, with
// repeats allowed, and the buy button stays shut until the count is exact.
interface Option {
  key: string;
  name: string;
  label: string;
  thumb: string;
  /** How many are in the drawer. Undefined means it is not being counted. */
  stock?: number;
}
interface Props {
  choose: number;
  options: Option[];
  class?: string;
}
const { choose, options, class: klass = '' } = Astro.props;
---

<div class:list={['pack-picker', klass]} data-pack-picker data-choose={String(choose)}>
  <div class="pack-picker__grid">
    {
      options.map((o) => (
        <div
          class:list={['pack-pick', o.stock === 0 && 'is-out']}
          data-slug={o.key}
          data-name={o.name}
          data-stock={o.stock === undefined ? undefined : String(o.stock)}
        >
          <button
            type="button"
            class="pack-pick__add"
            disabled={o.stock === 0}
            aria-label={o.stock === 0 ? `${o.name}, out of stock` : `Add one ${o.name}`}
          >
            <img src={o.thumb} alt="" loading="lazy" decoding="async" />
            {/* Two of these are the same logo at different sizes, so the
                thumbnail alone cannot tell them apart. */}
            <span class="pack-pick__label">{o.stock === 0 ? 'Sold out' : o.label}</span>
          </button>
          <span class="pack-pick__qty" aria-hidden="true" hidden>0</span>
          <button type="button" class="pack-pick__less" aria-label={`Remove one ${o.name}`} hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 12h14"/></svg>
          </button>
        </div>
      ))
    }
  </div>

  <p class="pack-picker__bar">
    <span data-pack-status aria-live="polite">Pick any {choose}</span>
    <button type="button" data-pack-reset hidden>Reset</button>
  </p>
</div>

<style>
  .pack-picker {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem;
  }
  .pack-picker__grid {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    align-content: center;
  }
  .pack-pick {
    position: relative;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.07);
    transition: background 0.15s ease;
  }
  .pack-pick:hover { background: rgba(255, 255, 255, 0.14); }
  .pack-pick.is-out { opacity: 0.38; }
  .pack-pick.is-out .pack-pick__add { cursor: not-allowed; }
  .pack-pick.is-picked { background: rgba(255, 255, 255, 0.18); box-shadow: inset 0 0 0 2px var(--color-purple-400, #8f88e8); }
  .pack-pick__add {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    width: 100%;
    height: 100%;
    padding: 0.25rem 0.15rem 0.2rem;
    cursor: pointer;
    border-radius: inherit;
  }
  .pack-pick__label {
    display: block;
    width: 100%;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .pack-pick.is-picked .pack-pick__label { color: #fff; }
  .pack-pick__add:disabled { cursor: not-allowed; opacity: 0.4; }
  .pack-pick__add img {
    flex: 1;
    width: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .pack-pick__qty {
    position: absolute;
    top: -0.3rem;
    right: -0.3rem;
    min-width: 1.4rem;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    background: var(--color-purple-500, #6e65dc);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    pointer-events: none;
  }
  .pack-pick__less {
    position: absolute;
    /* Opposite corner from the quantity badge, and clear of the label that
       runs along the bottom of the tile. */
    top: -0.3rem;
    left: -0.3rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(4, 12, 36, 0.85);
    color: #fff;
    cursor: pointer;
  }
  .pack-pick__less:hover { background: rgba(4, 12, 36, 1); }

  .pack-picker__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.4rem 0.2rem 0.1rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .pack-picker__bar[data-full] { color: #fff; }
  .pack-picker__bar button {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: underline;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
    cursor: pointer;
  }
  .pack-picker__bar button:hover { color: #fff; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pack-picker]').forEach((picker) => {
    // Bind once. A hot reload, or a client side navigation later, would
    // otherwise stack a second set of listeners and count every tap twice.
    if (picker.dataset.packBound) return;
    picker.dataset.packBound = '1';

    const choose = Number(picker.dataset.choose ?? 5);
    const tiles = [...picker.querySelectorAll<HTMLElement>('.pack-pick')];
    const status = picker.querySelector<HTMLElement>('[data-pack-status]')!;
    const bar = picker.querySelector<HTMLElement>('.pack-picker__bar')!;
    const reset = picker.querySelector<HTMLButtonElement>('[data-pack-reset]')!;
    const card = picker.closest('article');
    const buy = card?.querySelector<HTMLElement>('[data-pack-buy]') ?? null;
    const baseHref = buy?.getAttribute('href') ?? '';

    const picked = new Map<string, number>();
    const total = () => [...picked.values()].reduce((a, b) => a + b, 0);

    // If the range cannot add up to a full pack, say so rather than leaving
    // someone tapping at greyed out tiles.
    const available = tiles.reduce(
      (sum, t) => sum + (t.dataset.stock === undefined ? Infinity : Number(t.dataset.stock)),
      0
    );

    function render() {
      const n = total();
      const full = n === choose;

      for (const tile of tiles) {
        const slug = tile.dataset.slug!;
        const stock = tile.dataset.stock === undefined ? Infinity : Number(tile.dataset.stock);
        const qty = picked.get(slug) ?? 0;
        const qtyEl = tile.querySelector<HTMLElement>('.pack-pick__qty')!;
        const less = tile.querySelector<HTMLButtonElement>('.pack-pick__less')!;
        const add = tile.querySelector<HTMLButtonElement>('.pack-pick__add')!;

        qtyEl.textContent = String(qty);
        qtyEl.hidden = qty === 0;
        less.hidden = qty === 0;
        tile.classList.toggle('is-picked', qty > 0);
        // Cannot pick more of a sticker than there are in the drawer.
        add.disabled = full || qty >= stock;
      }

      status.textContent = full
        ? `${choose} of ${choose} chosen`
        : `${n} of ${choose} chosen`;
      if (n === 0) status.textContent = `Tap ${choose} stickers to build your pack`;
      if (available < choose) status.textContent = 'Not enough in stock';
      bar.toggleAttribute('data-full', full);
      reset.hidden = n === 0;

      // Publish the selection so the add to cart button can pick it up.
      const chosen: string[] = [];
      const chosenLabels: string[] = [];
      for (const [k, q] of picked) {
        for (let i = 0; i < q; i++) chosen.push(k);
        const tile = tiles.find((t) => t.dataset.slug === k);
        chosenLabels.push(`${tile?.querySelector('.pack-pick__label')?.textContent?.trim() ?? k} x${q}`);
      }
      picker.dataset.packChosen = chosen.join(',');
      picker.dataset.packChosenLabels = chosenLabels.join('|');

      if (buy) {
        buy.toggleAttribute('data-pack-locked', !full);
        buy.setAttribute('aria-disabled', String(!full));
        if (buy instanceof HTMLButtonElement) buy.disabled = !full;
        // People were reading the greyed out button as sold out and leaving,
        // so it now carries the instruction itself rather than relying on the
        // status line above it being noticed.
        const left = choose - n;
        buy.textContent =
          available < choose
            ? 'Sold out'
            : full
              ? 'Add this pack'
              : n === 0
                ? `Pick ${choose} stickers`
                : `Pick ${left} more sticker${left === 1 ? '' : 's'}`;
        if (baseHref) {
          // Carry the choice through to Stripe, where it lands on the payment
          // as the client reference so the order can actually be packed.
          const ref = [...picked.entries()].map(([s, q]) => `${s}x${q}`).join('_').slice(0, 190);
          buy.setAttribute('href', full ? `${baseHref}${baseHref.includes('?') ? '&' : '?'}client_reference_id=${ref}` : baseHref);
        }
      }
    }

    for (const tile of tiles) {
      const slug = tile.dataset.slug!;
      const stock = tile.dataset.stock === undefined ? Infinity : Number(tile.dataset.stock);
      tile.querySelector('.pack-pick__add')!.addEventListener('click', () => {
        if (total() >= choose) return;
        const qty = picked.get(slug) ?? 0;
        if (qty >= stock) return;
        picked.set(slug, qty + 1);
        render();
      });
      tile.querySelector('.pack-pick__less')!.addEventListener('click', () => {
        const qty = (picked.get(slug) ?? 0) - 1;
        if (qty > 0) picked.set(slug, qty);
        else picked.delete(slug);
        render();
      });
    }

    reset.addEventListener('click', () => {
      picked.clear();
      render();
    });

    render();
  });
</script>
