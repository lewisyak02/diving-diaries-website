---
// Live sticker viewer. The holographic path derives its foil mask from the
// artwork's own luminance, so white regions read as rainbow substrate and
// printed ink stays its own colour. Matte is the same renderer with the
// material switched, for transfer decals that have no foil.
//
// Renders a static poster first and swaps the canvas in underneath it once
// WebGL is ready, so there is no layout shift and never a blank box.
interface Props {
  src: string;              // texture: the artwork the renderer draws
  alt: string;
  poster?: string;          // static image shown until the canvas is live
  material?: 'holo' | 'matte' | 'decal';
  dieCut?: 'circle' | 'none';
  /** Decal only: the drop shadow finish. */
  dropShadow?: boolean;
  intensity?: number;
  hueScale?: number;
  tileScale?: number;
  grain?: number;
  /** Manifest for the pre rendered scrub sequence, used on low power devices. */
  spin?: string;
  class?: string;
}
const {
  src,
  alt,
  poster,
  material = 'matte',
  dieCut = 'none',
  dropShadow = false,
  intensity = 0.9,
  hueScale = 1,
  tileScale = material === 'holo' ? 1.15 : 1,
  grain = material === 'holo' ? 0.05 : 0,
  spin,
  class: klass = '',
} = Astro.props;
---

<div
  class:list={['holo-stage', klass]}
  data-holo
  data-src={src}
  data-material={material}
  data-die-cut={dieCut}
  data-intensity={String(intensity)}
  data-hue-scale={String(hueScale)}
  data-tile-scale={String(tileScale)}
  data-grain={String(grain)}
  data-spin={spin}
  data-drop-shadow={dropShadow ? '1' : undefined}
>
  <img class="holo-stage__poster" src={poster ?? src} alt={alt} loading="lazy" decoding="async" />
  <canvas class="holo-stage__canvas" tabindex="0" role="img" aria-label={alt}></canvas>
  <!-- Touch has no hover, so the interaction needs saying out loud. The alt
       text already carries it for screen readers. -->
  <div class="holo-stage__hint" aria-hidden="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 7 4 12l4 5M16 7l4 5-4 5" />
    </svg>
    Drag to move
  </div>
</div>

<style>
  .holo-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; /* reserved up front, so nothing shifts */
    overflow: hidden;
  }
  .holo-stage__poster,
  .holo-stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .holo-stage__poster {
    object-fit: cover;
    transition: opacity 0.35s ease;
  }
  .holo-stage__canvas {
    opacity: 0;
    transition: opacity 0.35s ease;
    /* Vertical page scroll stays with the page; horizontal drag is ours. */
    touch-action: pan-y;
    cursor: grab;
    outline: none;
  }
  .holo-stage__canvas:active { cursor: grabbing; }
  .holo-stage__canvas:focus-visible {
    outline: 3px solid var(--color-purple-400, #8f88e8);
    outline-offset: -3px;
  }
  .holo-stage.is-live .holo-stage__canvas { opacity: 1; }
  .holo-stage.is-live .holo-stage__poster { opacity: 0; }

  /* Pre rendered scrub sequence: a sprite sheet stepped by the pointer. */
  .holo-stage__scrub {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    touch-action: pan-y;
    cursor: grab;
    outline: none;
  }
  .holo-stage__scrub:active { cursor: grabbing; }
  .holo-stage__scrub:focus-visible {
    outline: 3px solid var(--color-purple-400, #8f88e8);
    outline-offset: -3px;
  }
  .holo-stage.is-scrub .holo-stage__poster { opacity: 0; }

  /* Drag hint */
  .holo-stage__hint {
    position: absolute;
    left: 50%;
    bottom: 0.85rem;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(4, 12, 36, 0.55);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .holo-stage__hint svg {
    animation: holo-hint-nudge 1.9s ease-in-out infinite;
  }
  @keyframes holo-hint-nudge {
    0%, 100% { transform: translateX(-2.5px); }
    50% { transform: translateX(2.5px); }
  }
  /* Only where there is no hover to discover it with, and only once the
     sticker is genuinely draggable. */
  @media (hover: none) and (pointer: coarse) {
    .holo-stage.is-live .holo-stage__hint,
    .holo-stage.is-scrub .holo-stage__hint {
      display: flex;
    }
    /* :not() rather than a later override, so showing and hiding cannot end up
       fighting over source order. Base opacity is 0, so it fades both ways. */
    .holo-stage.is-live:not(.has-touched) .holo-stage__hint,
    .holo-stage.is-scrub:not(.has-touched) .holo-stage__hint {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .holo-stage__hint svg { animation: none; }
  }

  /* No WebGL: CSS 3D transform plus a layered gradient, driven by the same
     angle the shader would have used. Falls back to the poster on its own if
     the image is all there is. */
  .holo-stage.is-css .holo-stage__poster {
    transform: perspective(900px) rotateY(var(--theta, 0deg)) rotateX(var(--tilt, 0deg));
    transition: transform 0.12s linear;
  }
  .holo-stage.is-css.is-holo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      rgba(255, 255, 255, 0) 18%,
      rgba(255, 176, 224, 0.55),
      rgba(168, 226, 255, 0.55),
      rgba(190, 255, 205, 0.55),
      rgba(255, 244, 176, 0.55),
      rgba(255, 255, 255, 0) 82%
    );
    background-size: 240% 240%;
    background-position: var(--sweep, 50%) 50%;
    mix-blend-mode: soft-light;
  }
  @media (prefers-reduced-motion: reduce) {
    .holo-stage.is-css .holo-stage__poster { transition: none; }
  }
</style>

<script>
  import { createHoloViewer } from '../lib/holo/viewer';

  const stages = document.querySelectorAll<HTMLElement>('[data-holo]');

  // CSS 3D fallback, driven by the same theta the shader takes.
  function cssFallback(stage: HTMLElement) {
    stage.classList.add('is-css');
    if (stage.dataset.material === 'holo') stage.classList.add('is-holo');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    stage.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      stage.style.setProperty('--theta', ((px - 0.5) * 120).toFixed(2) + 'deg');
      stage.style.setProperty('--tilt', ((0.5 - py) * 30).toFixed(2) + 'deg');
      stage.style.setProperty('--sweep', (px * 100).toFixed(1) + '%');
    });
    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--theta', '0deg');
      stage.style.setProperty('--tilt', '0deg');
    });
    if (reduced) stage.style.setProperty('--theta', '0deg');
  }

  // Devices that should not be asked to run a fragment shader per pixel.
  function lowPower() {
    const cores = navigator.hardwareConcurrency ?? 8;
    const mem = (navigator as any).deviceMemory ?? 8;
    return cores <= 2 || mem <= 2;
  }

  // Pre rendered scrub sequence. Same angles the shader would have drawn,
  // stepped through a sprite sheet instead of rendered live.
  async function scrubFallback(stage: HTMLElement, url: string) {
    let m: any;
    try {
      const res = await fetch(url);
      if (!res.ok) return false;
      m = await res.json();
    } catch {
      return false;
    }

    const el = document.createElement('div');
    el.className = 'holo-stage__scrub';
    el.tabIndex = 0;
    el.setAttribute('role', 'img');
    el.setAttribute('aria-label', stage.querySelector('img')?.alt ?? '');
    el.style.backgroundImage = `url(${m.sheet})`;
    el.style.backgroundSize = `${m.cols * 100}% ${m.rows * 100}%`;

    const mid = Math.floor(m.frames / 2);
    const show = (i: number) => {
      const f = Math.max(0, Math.min(m.frames - 1, Math.round(i)));
      const col = f % m.cols;
      const row = Math.floor(f / m.cols);
      el.style.backgroundPosition =
        `${(col / (m.cols - 1)) * 100}% ${(row / (m.rows - 1)) * 100}%`;
    };
    show(mid);

    const fromX = (clientX: number) => {
      const r = el.getBoundingClientRect();
      show(((clientX - r.left) / r.width) * (m.frames - 1));
    };
    el.addEventListener('pointerdown', (e) => {
      el.setPointerCapture(e.pointerId);
      fromX(e.clientX);
    });
    el.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || el.hasPointerCapture(e.pointerId)) fromX(e.clientX);
    });
    el.addEventListener('pointerleave', () => show(mid));
    el.addEventListener('keydown', (e) => {
      const cur = Number(el.dataset.frame ?? mid);
      if (e.key === 'ArrowLeft') { e.preventDefault(); el.dataset.frame = String(cur - 1); show(cur - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); el.dataset.frame = String(cur + 1); show(cur + 1); }
    });

    stage.appendChild(el);
    stage.classList.add('is-scrub');
    return true;
  }

  // Only build the GL context once the card is near the viewport.
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const stage = entry.target as HTMLElement;
        io.unobserve(stage);
        init(stage);
      }
    },
    { rootMargin: '200px' }
  );

  async function init(stage: HTMLElement) {
    const canvas = stage.querySelector<HTMLCanvasElement>('.holo-stage__canvas');
    if (!canvas) return;

    // Low power devices get the pre rendered scrub rather than the shader.
    if (stage.dataset.spin && lowPower()) {
      if (await scrubFallback(stage, stage.dataset.spin)) return;
    }

    try {
      const viewer = await createHoloViewer(canvas, {
        src: stage.dataset.src!,
        material: stage.dataset.material as 'holo' | 'matte' | 'decal',
        dieCut: stage.dataset.dieCut === 'circle' ? 'circle' : 'none',
        dropShadow: stage.dataset.dropShadow === '1',
        intensity: Number(stage.dataset.intensity ?? 0.9),
        hueScale: Number(stage.dataset.hueScale ?? 1),
        tileScale: Number(stage.dataset.tileScale ?? 1),
        grain: Number(stage.dataset.grain ?? 0),
      });
      if (viewer) { stage.classList.add('is-live'); return; }
    } catch {
      /* fall through to the cheaper tiers */
    }
    // No WebGL: the scrub sequence if there is one, otherwise CSS 3D.
    if (stage.dataset.spin && (await scrubFallback(stage, stage.dataset.spin))) return;
    cssFallback(stage);
  }

  stages.forEach((s) => io.observe(s));

  // Once someone has dragged one sticker they know the rest move too, so the
  // hint retires for the whole visit rather than nagging on every card.
  const HINT_KEY = 'dd-sticker-dragged';
  const retireHints = () => stages.forEach((s) => s.classList.add('has-touched'));
  try {
    if (sessionStorage.getItem(HINT_KEY)) retireHints();
  } catch {
    /* private mode, the hint just shows again next visit */
  }
  document.addEventListener(
    'pointerdown',
    (e) => {
      if (!(e.target as HTMLElement).closest?.('[data-holo]')) return;
      retireHints();
      try {
        sessionStorage.setItem(HINT_KEY, '1');
      } catch {
        /* nothing to remember it with, no harm done */
      }
    },
    { passive: true }
  );
</script>
