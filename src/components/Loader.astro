---
// Full-screen loading buffer: the 3D DD logo spin plays until the page finishes
// loading, then fades out. Shows on every page load.
---
<div id="dd-loader" aria-hidden="true">
  <video autoplay muted loop playsinline poster="/loader/dd-spin-poster.jpg">
    <source src="/loader/dd-spin.mp4" type="video/mp4" />
  </video>
</div>

<script is:inline>
  (function () {
    var start = Date.now();
    var MIN = 600; // let the spin show for at least this long
    function hide() {
      var el = document.getElementById('dd-loader');
      if (!el || el.dataset.hidden) return;
      el.dataset.hidden = '1';
      var wait = Math.max(0, MIN - (Date.now() - start));
      setTimeout(function () {
        el.classList.add('dd-hide');
        setTimeout(function () { el.style.display = 'none'; }, 550);
      }, wait);
    }
    if (document.readyState === 'complete') hide();
    else window.addEventListener('load', hide);
    setTimeout(hide, 4000); // safety net
  })();
</script>
