---
// The three boardshort styles, signed off at design review round 2. Used by the
// home page teaser and the shop, so the two can never drift apart.
// Source art: Marketing/Merch/Boardshorts/review/5-final-check.png
interface Props {
  /** Dark surfaces need the card to carry its own light background. */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;

export const BOARDSHORT_STYLES = [
  {
    slug: 'night-dive',
    name: 'Night Dive',
    blurb: 'Piece dyed navy with cream side panels and purple bartacks.',
  },
  {
    slug: 'turtle-stripe',
    name: 'Turtle Stripe',
    blurb: 'Sea mist body with turtle shell side panels and deep green edges.',
  },
  {
    slug: 'zebra-shark',
    name: 'Zebra Shark',
    blurb: 'A mosaic taken from zebra shark skin, with a reef brown stripe.',
  },
];
---

<div class="grid gap-6 sm:grid-cols-3">
  {
    BOARDSHORT_STYLES.map((s) => (
      <figure class="flex flex-col">
        {/* The ratio is pinned so the row holds its height before the art
            loads. Without it the page grows under a #boardshorts jump and the
            anchor lands past the section. */}
        <div class="aspect-[760/700] overflow-hidden rounded-2xl border border-ocean-100 bg-white">
          <img
            src={`/images/boardshorts/${s.slug}.webp`}
            alt={`The ${s.name} boardshort, front view`}
            width="760"
            height="700"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>
        <figcaption class="mt-3">
          <p class:list={['text-sm font-bold uppercase tracking-wide', onDark ? 'text-white' : 'text-ocean-800']}>
            {s.name}
          </p>
          <p class:list={['mt-1 text-sm leading-relaxed', onDark ? 'text-ocean-200' : 'text-slate-600']}>
            {s.blurb}
          </p>
        </figcaption>
      </figure>
    ))
  }
</div>
