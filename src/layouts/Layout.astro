---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Hide the chrome (header/footer) — used by the CMS route. */
  bare?: boolean;
}
const { title, description, image, noindex, type, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} noindex={noindex} type={type} />
    {!bare && <link rel="preload" as="video" href="/loader/dd-spin-loop.mp4" type="video/mp4" />}
    <!-- The intro has to paint before the stylesheet that would style it has even
         arrived, so its few rules are inline. These stay at the top level of the
         template: inside a {} expression Astro parses the contents as JSX and the
         wrapper leaks into the page as text, which silently breaks both. -->
    <style is:inline>
      #dd-loader {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: grid;
        place-items: center;
        /* The badge cannot be a transparent video: Safari will not composite
           alpha in WebM and h264 cannot carry it at all, so it arrives on a
           painted plate. A navy that dark does not survive h264 intact either,
           and the plate lands a few values off whatever flat colour sits behind
           it, which is enough to read as a lighter rectangle. So there is no
           flat colour behind it to compare against: a soft pool of light,
           centred where the badge is, that the plate simply sits inside. */
        background:
          radial-gradient(60% 52% at 50% 50%, rgb(4, 26, 70) 0%, rgb(1, 18, 58) 62%, rgb(1, 15, 48) 100%),
          rgb(1, 18, 58);
        transition: opacity 0.5s ease, visibility 0.5s;
      }
      #dd-loader video, #dd-loader img {
        /* Wider than the badge looks, because the clip carries margin around it
           for the feather below. */
        width: min(74vw, 420px);
        max-width: 100%;
        display: block;
        transition: opacity 0.26s ease, transform 0.5s cubic-bezier(0.32, 0, 0.2, 1);
        /* The clip is cropped tight to the badge with margin left for this: it
           holds solid across the artwork, which reaches 36% wide and 25% tall
           from the middle, then fades out well before the frame ends, so the
           plate never presents an edge anywhere. */
        -webkit-mask-image: radial-gradient(ellipse 50% 46% at 50% 50%, #000 78%, transparent 100%);
        mask-image: radial-gradient(ellipse 50% 46% at 50% 50%, #000 78%, transparent 100%);
      }
      #dd-loader img { display: none; }
      /* The badge comes at you and blurs past, the way a sting pushes through a
         logo, and the navy follows a beat later. Two moves, not one dissolve. */
      #dd-loader.is-gone video, #dd-loader.is-gone img {
        opacity: 0;
        transform: scale(1.22);
        filter: blur(5px);
        transition: opacity 0.42s ease-in, transform 0.52s cubic-bezier(0.55, 0, 0.9, 0.35),
          filter 0.42s ease-in;
      }
      #dd-loader.is-gone {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.18s, visibility 0.6s 0.18s;
      }
      /* Reduced motion gets the landed badge and the same fade, with no spin. */
      @media (prefers-reduced-motion: reduce) {
        #dd-loader video { display: none; }
        #dd-loader img { display: block; }
        #dd-loader, #dd-loader video, #dd-loader img { transition: opacity 0.3s ease; }
        #dd-loader.is-gone video, #dd-loader.is-gone img { transform: none; filter: none; }
      }
    </style>
    <noscript>
      <style is:inline>
        #dd-loader { display: none !important; }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    {
      !bare && (
        <div id="dd-loader" aria-hidden="true">
          <video
            src="/loader/dd-spin-loop.mp4"
            poster="/loader/dd-spin-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          />
          <img src="/loader/dd-spin-poster.jpg" alt="" />
        </div>
      )
    }
    {!bare && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <script is:inline>
      (function () {
        var el = document.getElementById('dd-loader');
        if (!el) return;
        // First visit only. Moving around the site does not replay it.
        var KEY = 'dd-seen-intro';
        try {
          if (sessionStorage.getItem(KEY)) {
            el.remove();
            return;
          }
        } catch (e) {
          /* private mode, the intro just plays again next visit */
        }
        // The page behind is usually ready in a few hundred milliseconds, sooner
        // than the spin clip itself finishes arriving, so being "ready" cannot be
        // the only thing that ends it or the intro is gone before it is seen.
        // It serves a minimum, timed from when the browser started loading.
        var MIN_MS = 1800;
        var MAX_MS = 4200;
        var done = false;
        var waiting = false;

        function finish() {
          if (done) return;
          done = true;
          try {
            sessionStorage.setItem(KEY, '1');
          } catch (e) {}
          el.classList.add('is-gone');
          // Only set once the intro has actually run, so a second page load just
          // renders normally instead of replaying the entrance.
          document.documentElement.classList.add('dd-intro-out');
          setTimeout(function () {
            el.remove();
            document.documentElement.classList.remove('dd-intro-out');
          }, 2200);
        }

        function ready() {
          if (waiting || done) return;
          waiting = true;
          setTimeout(finish, Math.max(0, MIN_MS - performance.now()));
        }

        // Ready means what is behind is worth looking at: the hero still on the
        // home page, otherwise the page itself. It never waits on the hero video,
        // which is megabytes.
        var hero = document.querySelector('main video[poster]');
        if (hero) {
          var probe = new Image();
          probe.onload = ready;
          probe.onerror = ready;
          probe.src = hero.getAttribute('poster');
          if (probe.complete) ready();
        } else if (document.readyState === 'complete') {
          ready();
        } else {
          window.addEventListener('load', ready);
        }
        // Never strand anyone on a spinning logo, whatever else goes wrong.
        setTimeout(finish, Math.max(0, MAX_MS - performance.now()));
      })();
    </script>
  </body>
</html>
