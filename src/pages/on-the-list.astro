---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
// Prerendered so Netlify picks the notify form up at deploy, the same way the
// contact form works.
export const prerender = true;
---

<Layout title="On the list" description="You will get an email when the boardshorts land." noindex={true}>
  <section class="mx-auto max-w-2xl px-5 pb-28 pt-40 text-center">
    <p class="kicker text-purple-500">Boardshorts</p>
    <h1 class="mt-3 text-4xl text-ocean-800">You are on the list</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      We will send you one email when the boardies go on sale, and nothing else.
      Until then there is plenty to watch.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/watch">Watch the dives</Button>
      <Button href="/shop" variant="outline">Back to the shop</Button>
    </div>
  </section>
</Layout>
