---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../lib/site';
export const prerender = true;
---

<Layout
  title="Order confirmed"
  description="Your Diving Diaries order is confirmed."
  noindex={true}
>
  <section class="mx-auto max-w-2xl px-5 pb-28 pt-40 text-center">
    <p class="kicker text-purple-500">Order confirmed</p>
    <h1 class="mt-3 text-4xl text-ocean-800">Thanks, that is on its way</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      Your stickers are packed by hand and posted within a couple of days.
      Stripe has emailed you a receipt.
    </p>
    <p class="mt-4 text-sm text-slate-500">
      Anything not right?
      Email <a href={`mailto:${SITE.email}`} class="font-semibold text-ocean-600 hover:underline">{SITE.email}</a> and
      mention the name on the order.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/shop" variant="primary">Back to the shop</Button>
      <Button href="/watch" variant="outline">Watch the dives</Button>
    </div>
  </section>
</Layout>

<script>
  // The order is placed, so the cart has done its job.
  import { clearCart } from '../lib/cart';
  clearCart();
</script>
