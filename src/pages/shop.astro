---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HoloSticker from '../components/HoloSticker.astro';
import StickerPicker from '../components/StickerPicker.astro';

const products = (await getCollection('products')).sort(
  (a, b) => (a.data.order ?? 1) - (b.data.order ?? 1)
);

// A pack picks from the other products, so it needs to look them up by slug.
const bySlug = new Map(products.map((p) => [p.id, p]));
const packOptions = (slugs: string[]) =>
  slugs
    .map((slug) => bySlug.get(slug))
    .filter((p) => p !== undefined)
    .map((p) => ({
      slug: p.id,
      name: p.data.name,
      thumb: p.data.image ?? p.data.artwork ?? '',
    }));
---

<Layout
  title="Shop"
  description="Diving Diaries stickers and merch. Support the channel and take a piece of the underwater world with you."
>
  <!-- Header -->
  <section class="relative overflow-hidden bg-ocean-900 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-ocean-900 via-ocean-950 to-purple-900/70"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-32 text-center">
      <p class="kicker text-purple-200">The shop</p>
      <h1 class="mt-3 text-4xl sm:text-6xl">Wear the brand</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ocean-100">
        Stickers now, more on the way. Every order helps fund the next dive and keeps
        the underwater world coming to your screen.
      </p>
    </div>
  </section>

  <!-- Products -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    {
      products.length > 0 ? (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => {
            const { name, price, image, artwork, dieCut, material, dropShadow, spin, altText, description, size, finish, finishes, pack, holographic, buyUrl, soldOut } = p.data;
            const canBuy = buyUrl && !soldOut;
            const texture = artwork ?? image;
            const surface = material ?? (holographic ? 'holo' : 'matte');
            return (
              <article class="flex flex-col overflow-hidden rounded-2xl border border-ocean-100 bg-white transition-all hover:shadow-xl">
                <div class="sticker-backdrop aspect-square" data-sticker-card>
                  {pack ? (
                    <StickerPicker choose={pack.choose} options={packOptions(pack.from)} />
                  ) : (
                    texture && (
                    <HoloSticker
                      src={texture}
                      poster={image}
                      alt={altText ?? name}
                      material={surface}
                      dieCut={dieCut}
                      dropShadow={dropShadow}
                      spin={spin}
                      class="h-full w-full"
                    />
                    )
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-xl text-ocean-800">{name}</h2>
                    {price && <span class="whitespace-nowrap font-display text-lg font-bold text-purple-600">${price}</span>}
                  </div>
                  {(size || finish) && (
                    <div class="mt-2 flex flex-wrap gap-2">
                      {size && <span class="rounded-full bg-ocean-50 px-3 py-1 text-xs font-semibold text-ocean-700">{size}</span>}
                      {finish && <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-semibold text-purple-700">{finish}</span>}
                    </div>
                  )}
                  {finishes && finishes.length > 1 && (
                    <div class="mt-3">
                      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Finish</p>
                      <div class="mt-1.5 inline-flex rounded-full bg-ocean-50 p-1" role="group" aria-label={`${name} finish`}>
                        {finishes.map((f, i) => (
                          <button
                            type="button"
                            data-finish
                            data-drop-shadow={f.dropShadow ? '1' : '0'}
                            aria-pressed={i === 0 ? 'true' : 'false'}
                            class="rounded-full px-3 py-1 text-xs font-semibold text-ocean-700 transition-colors aria-pressed:bg-purple-500 aria-pressed:text-white"
                          >
                            {f.label}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
                  {description && <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>}
                  <div class="mt-5">
                    {canBuy ? (
                      <a
                        href={buyUrl}
                        data-pack-buy={pack ? '' : undefined}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block rounded-full bg-purple-500 py-3 text-center text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-purple-600 aria-disabled:pointer-events-none aria-disabled:bg-slate-200 aria-disabled:text-slate-400"
                      >
                        {pack ? 'Buy this pack' : 'Buy now'}
                      </a>
                    ) : soldOut ? (
                      <span class="block rounded-full bg-slate-100 py-3 text-center text-sm font-bold uppercase tracking-wide text-slate-400">Sold out</span>
                    ) : (
                      <span class="block rounded-full bg-ocean-50 py-3 text-center text-sm font-bold uppercase tracking-wide text-ocean-400">Coming soon</span>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-ocean-200 bg-sand-50 p-12 text-center">
          <p class="text-slate-600">The shop is opening soon. Stickers are on the way.</p>
        </div>
      )
    }

    <p class="mt-12 text-center text-sm text-slate-500">
      Secure checkout. Questions about an order?
      Email <a href="mailto:divingdiariesau@gmail.com" class="font-semibold text-ocean-600 hover:underline">divingdiariesau@gmail.com</a>.
    </p>
  </section>
</Layout>

<script>
  // Finish buttons drive the sticker viewer on the same card. The card knows
  // nothing about WebGL; it just says which finish it wants.
  document.querySelectorAll<HTMLElement>('article').forEach((card) => {
    const buttons = card.querySelectorAll<HTMLButtonElement>('[data-finish]');
    if (!buttons.length) return;
    const stage = card.querySelector<HTMLElement>('[data-holo]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // The fallback tiers cannot redraw, so do not pretend they can.
        if (!stage?.dataset.canSwitch) return;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        stage.dispatchEvent(
          new CustomEvent('holo:finish', {
            detail: { dropShadow: btn.dataset.dropShadow === '1' },
          })
        );
      });
    });
  });
</script>
