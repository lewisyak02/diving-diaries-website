---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HoloSticker from '../components/HoloSticker.astro';
import StickerPicker from '../components/StickerPicker.astro';

const products = (await getCollection('products')).sort(
  (a, b) => (a.data.order ?? 1) - (b.data.order ?? 1)
);

// A pack picks from the other products, so it needs to look them up by slug.
const bySlug = new Map(products.map((p) => [p.id, p]));
const packOptions = (entries: { product: string; dropShadow: boolean }[]) =>
  entries
    .map((e) => ({ e, p: bySlug.get(e.product) }))
    .filter((x) => x.p !== undefined)
    .map(({ e, p }) => {
      // A finish is its own line item, so it needs its own key, label and
      // thumbnail. The drop shadow poster sits beside the plain one.
      const finish = e.dropShadow
        ? p!.data.finishes?.find((f) => f.dropShadow)?.label ?? 'Drop shadow'
        : p!.data.finishes?.find((f) => !f.dropShadow)?.label ?? '';
      const base = p!.data.packLabel ?? p!.data.name;
      const poster = p!.data.image ?? p!.data.artwork ?? '';
      return {
        key: e.dropShadow ? `${p!.id}-drop-shadow` : p!.id,
        name: finish ? `${p!.data.name}, ${finish.toLowerCase()}` : p!.data.name,
        label: finish ? `${base} ${finish}` : base,
        thumb: e.dropShadow ? poster.replace(/--poster\.webp$/, '--poster-drop-shadow.webp') : poster,
        // Both finishes come out of the same drawer.
        stock: p!.data.stock,
      };
    });
---

<Layout
  title="Shop"
  description="Diving Diaries stickers and merch. Support the channel and take a piece of the underwater world with you."
>
  <!-- Header -->
  <section class="relative overflow-hidden bg-ocean-900 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-ocean-900 via-ocean-950 to-purple-900/70"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-32 text-center">
      <p class="kicker text-purple-200">The shop</p>
      <h1 class="mt-3 text-4xl sm:text-6xl">Wear the brand</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ocean-100">
        Stickers now, more on the way. Every order helps fund the next dive and keeps
        the underwater world coming to your screen.
      </p>
    </div>
  </section>

  <!-- Products -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    {
      products.length > 0 ? (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => {
            const { name, price, compareAt, stock, minOrder, image, artwork, dieCut, material, dropShadow, spin, altText, description, size, finish, finishes, pack, holographic, buyUrl, soldOut } = p.data;
            // A counted product with nothing left is sold out, whatever the flag says.
            const out = soldOut || stock === 0;
            const canBuy = buyUrl && !out;
            const lowStock = stock !== undefined && stock > 0 && stock <= 5;
            const texture = artwork ?? image;
            const surface = material ?? (holographic ? 'holo' : 'matte');
            return (
              <article class="flex flex-col overflow-hidden rounded-2xl border border-ocean-100 bg-white transition-all hover:shadow-xl">
                <div class="sticker-backdrop aspect-square" data-sticker-card>
                  {pack ? (
                    <StickerPicker choose={pack.choose} options={packOptions(pack.from)} />
                  ) : (
                    texture && (
                    <HoloSticker
                      src={texture}
                      poster={image}
                      alt={altText ?? name}
                      material={surface}
                      dieCut={dieCut}
                      dropShadow={dropShadow}
                      spin={spin}
                      class="h-full w-full"
                    />
                    )
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-xl text-ocean-800">{name}</h2>
                    <span class="flex shrink-0 items-baseline gap-1.5">
                      {compareAt && <span class="font-display text-sm text-slate-400 line-through">${compareAt}</span>}
                      {price && <span class="whitespace-nowrap font-display text-lg font-bold text-purple-600">${price}</span>}
                    </span>
                  </div>
                  {(size || finish) && (
                    <div class="mt-2 flex flex-wrap gap-2">
                      {size && <span class="rounded-full bg-ocean-50 px-3 py-1 text-xs font-semibold text-ocean-700">{size}</span>}
                      {finish && <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-semibold text-purple-700">{finish}</span>}
                    </div>
                  )}
                  {finishes && finishes.length > 1 && (
                    <div class="mt-3">
                      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Finish</p>
                      <div class="mt-1.5 inline-flex rounded-full bg-ocean-50 p-1" role="group" aria-label={`${name} finish`}>
                        {finishes.map((f, i) => (
                          <button
                            type="button"
                            data-finish
                            data-drop-shadow={f.dropShadow ? '1' : '0'}
                            aria-pressed={i === 0 ? 'true' : 'false'}
                            class="rounded-full px-3 py-1 text-xs font-semibold text-ocean-700 transition-colors aria-pressed:bg-purple-500 aria-pressed:text-white"
                          >
                            {f.label}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
                  {(minOrder || out || lowStock) && (
                    <p class="mt-2 text-xs font-semibold uppercase tracking-wide">
                      {out ? (
                        <span class="text-slate-400">Out of stock</span>
                      ) : lowStock ? (
                        <span class="text-purple-600">Only {stock} left</span>
                      ) : null}
                      {minOrder && !out && (
                        <span class="text-slate-400">{lowStock ? ' · ' : ''}Minimum order {minOrder}</span>
                      )}
                    </p>
                  )}
                  {description && <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>}
                  <div class="mt-5">
                    {price && !out ? (
                      <button
                        type="button"
                        data-add-to-cart
                        data-slug={p.id}
                        data-name={name}
                        data-price={price}
                        data-thumb={image}
                        data-stock={stock === undefined ? undefined : String(stock)}
                        data-min={minOrder ? String(minOrder) : undefined}
                        data-pack-buy={pack ? '' : undefined}
                        class="block w-full rounded-full bg-purple-500 py-3 text-center text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-purple-600 aria-disabled:pointer-events-none aria-disabled:bg-slate-200 aria-disabled:text-slate-400"
                      >
                        {pack ? 'Add this pack' : minOrder ? `Add ${minOrder} to cart` : 'Add to cart'}
                      </button>
                    ) : out ? (
                      <span class="block rounded-full bg-slate-100 py-3 text-center text-sm font-bold uppercase tracking-wide text-slate-400">Sold out</span>
                    ) : (
                      <span class="block rounded-full bg-ocean-50 py-3 text-center text-sm font-bold uppercase tracking-wide text-ocean-400">Coming soon</span>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-ocean-200 bg-sand-50 p-12 text-center">
          <p class="text-slate-600">The shop is opening soon. Stickers are on the way.</p>
        </div>
      )
    }

    <p class="mt-12 text-center text-sm text-slate-500">
      Shipping is $1.50 Australia wide, whatever you order.
      Secure checkout. Questions about an order?
      Email <a href="mailto:divingdiariesau@gmail.com" class="font-semibold text-ocean-600 hover:underline">divingdiariesau@gmail.com</a>.
    </p>
  </section>
</Layout>

<script>
  import { addToCart } from '../lib/cart';

  // Add to cart. A pack carries the picked variants with it; a product with
  // switchable finishes carries whichever finish is showing.
  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    if (btn.dataset.cartBound) return;
    btn.dataset.cartBound = '1';
    const card = btn.closest('article')!;
    const picker = card.querySelector<HTMLElement>('[data-pack-picker]');

    btn.addEventListener('click', () => {
      const stock = btn.dataset.stock === undefined ? undefined : Number(btn.dataset.stock);
      const min = btn.dataset.min ? Number(btn.dataset.min) : 1;
      const price = parseFloat(btn.dataset.price!);
      let id = btn.dataset.slug!;
      let name = btn.dataset.name!;
      let thumb = btn.dataset.thumb;
      let pack: string[] | undefined;
      let packLabels: string[] | undefined;

      if (picker) {
        // The picker gates this button, so by here the count is right.
        const chosen = (picker.dataset.packChosen ?? '').split(',').filter(Boolean);
        pack = chosen;
        packLabels = (picker.dataset.packChosenLabels ?? '').split('|').filter(Boolean);
      } else {
        const pressed = card.querySelector<HTMLButtonElement>('[data-finish][aria-pressed="true"]');
        if (pressed?.dataset.dropShadow === '1') {
          id += ':ds';
          name += ' (drop shadow)';
          thumb = thumb?.replace(/--poster\.webp$/, '--poster-drop-shadow.webp');
        }
      }

      addToCart({ id, qty: min, name, price, thumb, pack, packLabels }, stock);
      window.dispatchEvent(new CustomEvent('dd-cart-open'));
      if (picker) picker.querySelector<HTMLButtonElement>('[data-pack-reset]')?.click();
    });
  });

  // Finish buttons drive the sticker viewer on the same card. The card knows
  // nothing about WebGL; it just says which finish it wants.
  document.querySelectorAll<HTMLElement>('article').forEach((card) => {
    const buttons = card.querySelectorAll<HTMLButtonElement>('[data-finish]');
    if (!buttons.length || card.dataset.finishBound) return;
    card.dataset.finishBound = '1';
    const stage = card.querySelector<HTMLElement>('[data-holo]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // The finish decides what actually gets ordered, so the choice is
        // always recorded. Only the redraw depends on a live viewer.
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (!stage?.dataset.canSwitch) return;
        stage.dispatchEvent(
          new CustomEvent('holo:finish', {
            detail: { dropShadow: btn.dataset.dropShadow === '1' },
          })
        );
      });
    });
  });
</script>
